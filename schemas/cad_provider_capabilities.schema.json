{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dios:cad-provider-capabilities:v1",
  "title": "DIOS provider-native CAD operation descriptors (public-safe)",
  "type": "object",
  "required": [
    "schema",
    "provider_id",
    "application_version",
    "modules",
    "operations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "dios.cad_provider_capabilities.v1"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "application_version": {
      "type": "string",
      "pattern": "^[0-9]{4}(\\.[0-9]{1,3}){0,2}$"
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Operation"
      }
    }
  },
  "$defs": {
    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "module",
        "effect",
        "arguments",
        "required",
        "since_version",
        "native_transaction_supported",
        "reversible"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "effect": {
          "enum": [
            "READ",
            "MUTATE",
            "DESTRUCTIVE",
            "AUTOMATE"
          ]
        },
        "arguments": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$"
          },
          "additionalProperties": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "object",
              "array"
            ]
          }
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "since_version": {
          "type": "string",
          "pattern": "^[0-9]{4}(\\.[0-9]{1,3}){0,2}$"
        },
        "until_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "native_transaction_supported": {
          "type": "boolean"
        },
        "reversible": {
          "type": "boolean"
        }
      }
    }
  }
}
